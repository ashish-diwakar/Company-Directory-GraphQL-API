# EXAMPLE ONLY: all passwords, secrets, and hosted domains below are dummy values.
# Copy to .env for local use. Keep .env private; never commit real credentials.
# URL-encode special characters in connection URL usernames/passwords.

# --- Local development (active defaults) ---
NODE_ENV=development
PORT=4000
# PORT is for local startup. Let Vercel manage its listener; no PORT setting is needed there.

# Local Docker PostgreSQL: docker compose up -d --wait
DATABASE_URL="postgresql://directory:replace-with-local-password@localhost:5432/company_directory"
POSTGRES_PASSWORD="replace-with-local-password"
# POSTGRES_PASSWORD is only for compose.yaml; match it in DATABASE_URL.
# The password on an existing Docker volume is not changed by editing this variable.
# Docker and POSTGRES_PASSWORD are unnecessary when using Neon.

# Generate a real random signing secret, for example:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-signing-secret"

# Exact browser origins, comma-separated. No paths, trailing slashes, quotes within values, or *.
ALLOWED_ORIGINS="http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4000,http://localhost:4000"
# For local embedded Apollo Sandbox, append: ,https://sandbox.embed.apollographql.com
# AUTH_DEMO_MODE is obsolete: demo/bypass authentication is not supported.

# --- Neon alternative: REPLACE DATABASE_URL above; do not keep duplicate active keys ---
# Pooled URL for the running API. Copy your actual provider URL and retain its TLS settings.
# DATABASE_URL="postgresql://neondb_owner:REPLACE_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
# Direct URL for Prisma CLI migrations, targeting the SAME database/schema.
# DIRECT_DATABASE_URL="postgresql://neondb_owner:REPLACE_PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# This app calls Neon's DATABASE_URL_UNPOOLED value DIRECT_DATABASE_URL.
# PGHOST / PGUSER / PGPASSWORD / POSTGRES_URL and other template aliases are not required.
# If DIRECT_DATABASE_URL is absent, Prisma CLI falls back to DATABASE_URL.
# After configuring a new empty database: npm run db:generate && npm run db:deploy
# Seeding is optional and replaces directory data; existing SQLite data is not imported.

# --- Vercel production: set these in the dashboard, NOT just in local .env ---
# NODE_ENV=production
# DATABASE_URL=<your actual Neon pooled URL>
# DIRECT_DATABASE_URL=<your actual Neon direct URL for the migration step>
# JWT_SECRET=<a real long random signing secret>
# ALLOWED_ORIGINS="https://your-frontend.vercel.app"
# Backend-only initial setup can use: https://your-backend.vercel.app
# For multiple trusted origins, use a comma-separated list of exact HTTPS origins.
# Production REJECTS empty origins, *, HTTP origins, paths, and trailing slashes.
# Production enables Secure HttpOnly cookies and disables Sandbox/introspection.
# Keep frontend/API routing compatible with SameSite=Lax cookies (prefer one public origin).
# Apply values to the intended Production/Preview environment, then redeploy.
# vercel.json selects the Express backend and npm run build; it does not deploy the frontend.
# Never place database URLs or JWT_SECRET in VITE_* variables; they are browser-public.

# --- Automated tests ---
# No installed database needed: npm run test:local starts a temporary PostgreSQL cluster.
# For npm test, use a SEPARATE disposable database with CREATE SCHEMA privileges.
# Never use developer/production database credentials for tests.
# TEST_DATABASE_URL="postgresql://directory:replace-with-test-password@localhost:5432/company_directory_test"

