DATABASE_URL="postgresql://directory:change-me@localhost:5432/company_directory"
# Local Docker only: match the password in DATABASE_URL (URL-encode special characters in the URL).
POSTGRES_PASSWORD="change-me"
# Optional direct connection for migrations when DATABASE_URL uses a provider pooler.
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"
# Tests require a separate disposable database; never use production credentials here.
# TEST_DATABASE_URL="postgresql://directory:change-me@localhost:5432/company_directory_test"
PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4000,http://localhost:4000
# Production: set NODE_ENV=production and exact HTTPS origins; cookies become Secure.

