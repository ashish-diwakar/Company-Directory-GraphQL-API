generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "sqlite"
}

enum AccountRole {
  ADMIN
  EMPLOYEE
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String
  role AccountRole @default(EMPLOYEE)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  sessions Session[]
  employeeId String? @unique
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
}

model Invitation {
  id String @id @default(uuid())
  email String
  tokenHash String @unique
  createdById String
  createdAt DateTime @default(now())
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  @@index([email])
  @@index([createdAt])
}

model Session {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([userId])
}

// Acquiring a write lock before counting accounts serializes first-admin registration.
model RegistrationLock {
  id Int @id
  version Int @default(0)
}
model Team {
  id String @id @default(uuid())
  name String
  department String
  members Employee[]
}
model Employee {
  id String @id @default(uuid())
  name String
  email String @unique
  role String
  teamId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)
  assignedEquipment Equipment[]
  account User?
  @@index([teamId])
  @@index([role])
}
model Equipment {
  id String @id @default(uuid())
  type String
  model String
  serialNumber String @unique
  assignedToId String?
  assignedTo Employee? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  @@index([assignedToId])
}

enum AssignmentAction {
  ASSIGNED
  REASSIGNED
  RETURNED
}

// Historical snapshots intentionally survive reseeding/deletion of directory records.
model AssignmentEvent {
  id String @id @default(uuid())
  equipmentId String
  equipmentModel String
  serialNumber String
  action AssignmentAction
  actorId String
  actorName String
  actorEmail String
  fromEmployeeId String?
  fromEmployeeName String?
  toEmployeeId String?
  toEmployeeName String?
  notes String?
  createdAt DateTime @default(now())
  @@index([equipmentId, createdAt])
  @@index([createdAt])
}

